

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
}



model Compte {
  id        Int       @id @default(autoincrement())
  fullName  String
  email     String    @unique
  phone     String?
  country   String?
  Password  String
  role      Role      @default(CLIENT)
  createdAt DateTime  @default(now())
}

enum Role {
  ADMIN
  CLIENT
  FARMER
  DELIVERY
}



enum OptionSelection {
  SINGLE   // pick one (size, meat type…)
  MULTIPLE // pick several (sauces, extras, ingredients…)
}

enum Fulfillment {
  DELIVERY
  PICKUP
}

// Adjust the list to your real kitchen workflow, then update STATUS_LABELS in lib/ordering/orders.js
enum OrderStatus {
  PENDING          // received, waiting for the restaurant
  CONFIRMED
  PREPARING
  READY            // ready for pickup
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

/* ----------------------------- catalog ----------------------------- */

model Category {
  id        String    @id @default(cuid())
  name      String
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id           String               @id @default(cuid())
  name         String
  description  String?
  price        Int
  imageUrl     String?
  available    Boolean              @default(true) // false = shown but not orderable (out of stock)
  isActive     Boolean              @default(true) // false = hidden from the menu
  sortOrder    Int                  @default(0)
  categoryId   String
  category     Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  optionGroups ProductOptionGroup[]
  orderItems   OrderItem[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([categoryId])
}

// A reusable group of choices (e.g. "Sauces", "Size", "Extras"). Attach it to every product that needs it.
model OptionGroup {
  id        String               @id @default(cuid())
  name      String
  selection OptionSelection      @default(SINGLE)
  required  Boolean              @default(false)
  minSelect Int                  @default(0)
  maxSelect Int? // null = unlimited (MULTIPLE only)
  options   Option[]
  products  ProductOptionGroup[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

model Option {
  id        String      @id @default(cuid())
  groupId   String
  group     OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String
  price     Int         @default(0) // extra charged, 0 = free
  available Boolean     @default(true)
  isActive  Boolean     @default(true)
  sortOrder Int         @default(0)

  @@index([groupId])
}

model ProductOptionGroup {
  productId String
  groupId   String
  sortOrder Int         @default(0)
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  group     OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([productId, groupId])
  @@index([groupId])
}

model Municipality {
  id          String  @id @default(cuid())
  name        String  @unique
  deliveryFee Int? // null = no fee configured
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)
  orders      Order[]
}

/* ------------------------------ orders ------------------------------ */

model Order {
  id        String      @id @default(cuid())
  reference String      @unique // e.g. BH-261015-K7Q2M, generated by the server
  status    OrderStatus @default(PENDING)
  fulfillment Fulfillment

  customerName  String
  customerPhone String // canonical form (see canonicalPhone)

  municipalityId   String?
  municipality     Municipality? @relation(fields: [municipalityId], references: [id], onDelete: SetNull)
  municipalityName String? // snapshot (also used when no municipality list exists)
  address          String?
  notes            String?

  subtotal    Int
  deliveryFee Int @default(0)
  total       Int

  idempotencyKey String @unique // prevents duplicate orders on retries / double clicks
  requestHash    String // detects the same key being reused with a different payload

  items     OrderItem[]
  history   OrderStatusHistory[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([customerPhone, createdAt])
  @@index([status, createdAt])
}

// Snapshot of what was ordered: later menu/price changes never alter past orders.
model OrderItem {
  id          String            @id @default(cuid())
  orderId     String
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  unitPrice   Int // base price + options
  quantity    Int
  lineTotal   Int
  options     OrderItemOption[]

  @@index([orderId])
}

model OrderItemOption {
  id          String    @id @default(cuid())
  orderItemId String
  item        OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  groupName   String
  optionName  String
  price       Int

  @@index([orderItemId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

/* ------------------------------ expenses ----------------------------- */

model Expense {
  id          String   @id @default(cuid())
  amount      Int
  description String
  category    String   @default("AUTRE")
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([category])
}

/* ------------------------------ feedback ----------------------------- */

enum FeedbackStatus {
  PENDING
  APPROVED
  REJECTED
}

model Feedback {
  id        String         @id @default(cuid())
  name      String         @default("Client")
  rating    Int            // 1 to 5
  topics    String[]       @default([])
  comment   String?
  status    FeedbackStatus @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([rating])
}

/* ----------------------- push notifications ----------------------- */

model PushSubscription {
  id             String    @id @default(cuid())
  token          String    @unique
  role           String    @default("CLIENT") // "ADMIN" | "CLIENT"
  adminEmail     String?
  orderReference String?
  customerPhone  String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([role])
  @@index([orderReference])
  @@index([customerPhone])
  @@index([adminEmail])
}

